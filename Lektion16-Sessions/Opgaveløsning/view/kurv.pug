doctype html
html
    head
        meta(charset='utf-8')
        title Kurv
    body
        h1 Kurv
        if kurv.linjer.length === 0
            p Kurven er tom
        else
            table
                each l in kurv.linjer
                    tr
                        td= l.navn
                        td #{l.antal} stk
                        td= l.sum
            p Total: #{kurv.total}

        button(onclick='clickfunction()') tøm kurv

        a(href='/index') Tilbage
        script.
            async function post(url, objekt) {
                const respons = await fetch(url, {
                    method: 'POST',
                    body: JSON.stringify(objekt),
                    headers: { 'Content-Type': 'application/json' }
                });
                if (respons.status !== 201) throw new Error(respons.status);
                return await respons.text();
            }

            let clickfunction = async () => {
                try {
                    await post('/toem', {});
                    window.location.href = '/kurv';
                } catch (e) {
                    alert('Fejl: ' + e.message);
                }
            };
            